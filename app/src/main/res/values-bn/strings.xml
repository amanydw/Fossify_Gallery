    <string name="restore_to_path">\'%s\'-এ পুনরুদ্ধার করা হচ্ছে</string>
    <string name="full_storage_permission_required">আপনার সব ছবি ও ভিডিও দেখাতে Fossify গ্যালারির সম্পূর্ণ অ্যাক্সেস প্রয়োজন। সেটিংস > অনুমতি > ছবি এবং ভিডিও > সব অনুমতি দিন-এ যান।</string>
    <string name="hide_folder_description">এই ফাংশনটি ফোল্ডারে একটি \'.nomedia\' ফাইল যোগ করে তা লুকায়, এটি সব সাবফোল্ডারও লুকাবে। সেটিংসে \'লুকানো আইটেম দেখান\' বিকল্পটি চালু করে সেগুলি দেখতে পারেন। চালিয়ে যাবেন?</string>
    <string name="exclude_folder_description">এটি শুধুমাত্র Fossify গ্যালারি থেকে নির্বাচনকে তার সাবফোল্ডারসহ বাদ দেবে। বাদ দেওয়া ফোল্ডারগুলো সেটিংসে পরিচালনা করতে পারেন।</string>
    <string name="exclude_folder_parent">পরিবর্তে একটি প্যারেন্ট বাদ দেবেন?</string>
    <string name="excluded_activity_placeholder">ফোল্ডার বাদ দিলে সেগুলো সাবফোল্ডারসহ শুধুমাত্র Fossify গ্যালারিতে লুকানো থাকবে; অন্যান্য অ্যাপে সেগুলো এখনও দেখা যাবে।

অন্য অ্যাপ থেকেও সেগুলো লুকাতে চাইলে, লুকান ফাংশনটি ব্যবহার করুন।</string>
    <string name="hidden_all_files">লুকানো ফাইল দেখতে আপনাকে অ্যাপটিকে সব ফাইল অ্যাক্সেস দিতে হবে, অন্যথায় এটি কাজ করবে না।</string>
    <string name="cant_unhide_folder">যদি কোনো ফোল্ডার বা তার প্যারেন্ট ফোল্ডারগুলোর একটির নামের আগে বিন্দু থাকে, তবে এটি লুকানো থাকে এবং এভাবে আর দেখানো যায় না। নাম পরিবর্তন করে বিন্দুটি সরাতে হবে।</string>
    <string name="included_activity_placeholder">যদি আপনার কিছু ফোল্ডারে মিডিয়া থাকে কিন্তু অ্যাপটি সেগুলো চিনতে না পারে, তবে এখানে ম্যানুয়ালি যোগ করতে পারেন।

এখানে কিছু যোগ করলে অন্য কোনো ফোল্ডার বাদ যাবে না।</string>
